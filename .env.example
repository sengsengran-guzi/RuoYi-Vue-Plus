# sensenran-guzi 部署环境变量模板
#
# 使用：
#   cp .env.example .env
#   按下面注释填入真实值（密码至少 16 位随机字符）
#   .env 已在 .gitignore，切勿提交
#
# 配合：script/docker/docker-compose.deploy.yml

# ============ 必填 ============

# 部署环境标识，影响容器名（gz-mysql-${DEPLOY_ENV} 等）
# 取值：prod / staging
DEPLOY_ENV=prod

# MySQL root 密码（容器初始化用 + ruoyi-admin 连库用）
# 生成命令：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=__CHANGE_ME_TO_RANDOM_24CHARS__

# MySQL 业务数据库名（默认 ry-vue，可改）
MYSQL_DATABASE=ry-vue

# Redis 密码
# 生成命令：openssl rand -base64 24
REDIS_PASSWORD=__CHANGE_ME_TO_RANDOM_24CHARS__

# ============ 微信小程序（真实登录 + 手机号需填）============
#
# 不填（留默认 wxMOCK）= 后端走 mock 通道：登录返伪 openid、手机号返固定 13800000000。
# 填真实值后自动切真实通道：
#   - 登录走 jscode2session（WxRealLoginAdapter）
#   - 手机号走 getuserphonenumber（WxRealPhoneAdapter，用 access_token 换明文）
# AppID 必须与小程序前端 manifest / .env.staging 的 VITE_WX_APPID 一致。
# AppSecret 在「微信公众平台 → 开发管理 → 开发设置」获取，切勿提交到 git。
WX_MA_APPID=wxMOCK
WX_MA_SECRET=

# ============ 拼豆核销码签名密钥（prod 必填）============
#
# GZ-BEAN-004 核销码 HMAC 签名密钥。prod profile 启动时 ProdSecretGuard 强制校验：
# 留空 / 占位（CHANGE_ME_BEFORE_PROD_DEPLOY）→ 拒绝启动（防核销码被伪造）。
# 生成：openssl rand -base64 32
GZ_BEAN_QR_SECRET=__CHANGE_ME_TO_RANDOM_32CHARS__

# ============ 微信支付 real 凭证（prod 必填，GZ-PAY-001）============
#
# prod profile 下 ProdSecretGuard 强制 WECHAT_PAY_CLIENT_MODE=real，否则拒绝启动
# （mock 客户端在 prod 生效 = /api/pay/v3/notify 零验签，可被伪造刷单）。
# real 模式 WechatPayV3ClientImpl 初始化还会校验 mchId/apiV3Key/私钥/公钥齐全，缺一 fail-fast。
#
# 机密值来自 secrets/wechat-pay/gz-pay.env（顶层 secrets/ 整体 gitignore，本机才有）。
# 把下面的值填成 gz-pay.env 里的真实值（去掉 export 前缀，docker --env-file 不认 export）。
#
# pem 文件不入 git：手动把 secrets/wechat-pay/ 整个目录（含 1731037015_*_cert/ 和 pub_key.pem）
# 放到本 .env 同级目录下（$REPO_DIR/secrets/wechat-pay/），compose 以只读卷挂进容器 /app/secrets/wechat-pay。
# pem 在容器内的路径已由 compose 写死（WECHAT_PAY_*_PATH），不在 .env 配。
WECHAT_PAY_CLIENT_MODE=mock
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=

# ============ 阿里云 OSS（运行时在 admin 网页配置，不在这里）============
#
# RuoYi-Vue-Plus 的 OSS 走数据库 sys_oss_config 表，运行时动态读取
# 部署完后第一件事：
#   1. 登录 admin 网页（默认 admin / admin123，立即改密码）
#   2. 进 "系统工具 → 对象存储配置"
#   3. 新增一条 type=aliyun 的配置：
#      - accessKey / secretKey （阿里云 RAM 子账号，仅授权 OSS 操作）
#      - endpoint（如 oss-cn-shanghai.aliyuncs.com）
#      - bucketName
#      - region（如 cn-shanghai）
#      - domain（CDN 加速域名，可选）
#      - isHttps：Y
#      - accessPolicy：private 或 public_read（看业务）
#   4. 设为"默认"启用
#
# 业务代码（GZ-SYS-005 gz_file_object 文件域）会自动用启用中的那条
